# =====================================================================
# 父子分块 RAG 检索系统 —— 环境变量样例
# 复制为 .env 后按需修改：  copy .env.example .env
# =====================================================================

APP_NAME=parent-child-rag
DEBUG=false

# ---------------------- 服务与安全 ----------------------
# CORS 允许来源，逗号分隔。默认仅本机；生产环境必须改为真实域名前缀列表。
# 注意：本项目显式关闭 allow_credentials，不会使用 "*" 通配来源。
CORS_ALLOW_ORIGINS=http://127.0.0.1,http://localhost
# 管理接口（POST /api/v1/admin/reindex、/admin/reset-cache-stats）的访问令牌。
# 留空 = 不校验（仅适合本机开发！）；非空时调用方必须带请求头 X-Admin-Token。
ADMIN_TOKEN=
# 上传文件大小上限（MB），防止超大文件耗尽内存
UPLOAD_MAX_MB=20
# 上传扩展名白名单，防止任意文件被当作文本解析
UPLOAD_ALLOW_EXT=.md,.markdown,.txt,.pdf
# 启动时预热 BM25 词表 / 嵌入模型 / 重排模型。
# 必须保持 true：否则第一次 /health 或业务请求会同步等待模型加载（可能数十秒），
# 导致健康检查超时、上游误判服务不可用。
WARMUP_ON_STARTUP=true

# =====================================================================
# 全部存储服务由本仓库 docker-compose.yml（项目名 par_sub_split）统一编排：
#     docker compose up -d    → 启动 MySQL / Redis / etcd / MinIO / Milvus
# 容器名一律为 par_sub_*；下面的主机与端口必须与 compose 的端口映射保持一致。
# =====================================================================

# ---------------------- MySQL（父文档表） ----------------------
# 注意：compose 把 MySQL 映射到宿主机 9999 端口（刻意避开默认 3306，防止端口冲突）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=9999
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=par_sub_split
MYSQL_ECHO=false

# ---------------------- Redis（父文档内容缓存） ----------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 缓存 key 前缀，最终 key 形态： psd:parent:123
REDIS_PARENT_PREFIX=psd:parent:
# 父文档缓存过期时间（秒），0 表示永不过期
REDIS_PARENT_TTL=0

# ---------------------- Milvus（子块向量库） ----------------------
MILVUS_URI=http://localhost:19530
# 本地 Milvus 开启了鉴权（COMMON_SECURITY_AUTHORIZATIONENABLED=true），
# token 格式为 "用户名:密码"，默认 root:Milvus，本机部署时被覆盖为下列值
MILVUS_TOKEN=root:123456
MILVUS_COLLECTION=child_chunk_t

# ---------------------- 分块参数 ----------------------
# 工业文档（故障码手册/SOP）建议：子块 180~220，父块 1600~1800
PARENT_CHUNK_SIZE=1200
PARENT_CHUNK_OVERLAP=120
CHILD_CHUNK_SIZE=280
CHILD_CHUNK_OVERLAP=60
# 送进大模型的单个父块最大字符数（超出截断，控制 token 成本）
MAX_PARENT_CHARS=4000

# ---------------------- 检索参数 ----------------------
RETRIEVE_TOP_K=20
FINAL_TOP_K=4
# rrf = 倒数排名融合（只依赖排名，无需归一化，安全默认）
# weighted = 加权分数融合（需按业务调参）
HYBRID_RANKER=rrf
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
# 父块低分过滤：低于「最高父块分数 × 该比例」的结果直接丢弃，避免陪跑内容污染 Prompt
SCORE_RATIO_THRESHOLD=0.2
# 说明：单分支对照检索（explain）由请求体参数控制，默认关闭，无全局开关

# ---------------------- 稀疏向量（BM25） ----------------------
SPARSE_ENABLED=true
BM25_K1=1.5
BM25_B=0.75

# ---------------------- 稠密向量 Embedding ----------------------
# hash   = 无依赖哈希向量（离线跑通全流程，检索质量弱，仅用于演示链路）
# local  = 本地 sentence-transformers 模型（推荐：BGE-M3）
# api    = OpenAI 兼容协议的外部 Embedding 服务
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
# BGE-M3 稠密维度为 1024，与本项目集合定义一致，切换模型无需改表
EMBEDDING_DIM=1024
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=16
LOCAL_MODEL_PATH=
# 8GB 显存要留给 7B LLM，嵌入默认走 CPU（i7-13650HX 14 核足够）
EMBEDDING_DEVICE=cpu
# 仅 device=cuda 时生效，可把 BGE-M3 显存占用从 2.1GB 降到约 1.1GB
EMBEDDING_FP16=false
# 查询指令前缀：bge-m3 留空；bge-large-zh 等非对称模型可填
# "为这个句子生成表示以用于检索相关文章："
EMBEDDING_QUERY_INSTRUCTION=

# ModelScope 本地模型缓存根目录（自动解析 BAAI/bge-m3 的快照路径）
# 注意：这里必须用正斜杠。dotenv 会吞掉未加引号的反斜杠，
#       写成 D:\modelscope\hub\models 会被解析成 D:\modelscope\hub。
MODELSCOPE_CACHE=D:/modelscope/hub/models

# ---------------------- Rerank 精排（可选，默认关闭） ----------------------
# 作用在「子块」上：子块才是检索单元，且文本短、cross-encoder 成本低
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_PATH=
RERANK_DEVICE=cpu
RERANK_FP16=false
# 参与重排的候选子块数（0 = 沿用 RETRIEVE_TOP_K）
RERANK_CANDIDATES=0
# 重排后保留的子块数（随后仍会按 parent_id 聚合）
RERANK_KEEP=10

# ---------------------- 大模型生成 ----------------------
# auto   = 有 API Key、或 base_url 指向本机时走 OpenAI 兼容协议
# ollama = 本地 Ollama（无需 Key，默认 http://127.0.0.1:11434/v1）
# openai = 远程 OpenAI 兼容服务（必须有 Key）
# mock   = 强制走抽取式降级
LLM_PROVIDER=ollama
LLM_OLLAMA_BASE=http://127.0.0.1:11434/v1
LLM_OLLAMA_MODEL=qwen2.5:7b
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
# 事实型问答用低温，可降低小模型"假拒绝/自相矛盾"的概率
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
# 本地 7B 首次调用含模型加载（实测约 5s），超时不宜设得过小
LLM_TIMEOUT=120
